# Supabase project shared with jebbs-dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DD3 (design.md): no default is provided anywhere in the code -- an unset
# or invalid value fails the build/boot on purpose. Read off the shop's
# current /precios screen before deploying, do not guess.
DELIVERY_FEE_ARS=2000

# Digits only, no "+", no separators, 8-15 characters (e.g. Argentina
# country + area code + number: 549XXXXXXXXXX).
NEXT_PUBLIC_WHATSAPP_NUMBER=5493450000000

# R16 (design.md): must stay exactly this value in every environment
# (dev, CI, and the deploy target) so the WhatsApp order timestamp matches
# what jebbs-dashboard prints for the same order.
TZ=America/Argentina/Buenos_Aires
